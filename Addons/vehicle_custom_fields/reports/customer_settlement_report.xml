<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_customer_settlement" model="ir.actions.report">
        <field name="name">Customer Settlement</field>
        <field name="model">car.rental.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vehicle_custom_fields.report_customer_settlement_doc</field>
        <field name="report_file">vehicle_custom_fields.report_customer_settlement_doc</field>
        <field name="paperformat_id" ref="paperformat_rental_contract"/>
    </record>

    <template id="report_customer_settlement_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <!-- رسالة لو العقد لسه قبل مرحلة Checking -->
                    <div class="page" t-if="o.state not in ['checking', 'invoice', 'done']" style="font-family: Arial, sans-serif; padding:60px 20px; text-align:center; font-size:16px; color:#000;">
                        The Customer Settlement Statement is available only after the contract reaches the <strong>Checking</strong> state.
                    </div>

                    <!-- الكشف الكامل (Checking وما بعدها) -->
                    <div class="page" t-if="o.state in ['checking', 'invoice', 'done']" style="font-family: Arial, sans-serif; font-size:13px; color:#000; padding:0 6px;">
                        <style>
                            .page * { border-color: transparent !important; outline: 0 !important; }
                            .page table, .page tr, .page td, .page th { border: 0 !important; }
                            .page td[style*="#ccc"] { border: 1px solid #ccc !important; }
                            .page td[style*="#ddd"] { border-bottom: 1px solid #ddd !important; }
                        </style>
                        <table style="width:100%; margin-bottom:8px;">
                            <tr>
                                <td style="vertical-align:middle; text-align:left; width:60%;">
                                    <div style="font-size:40px; font-weight:bold; letter-spacing:10px; line-height:1;">ALESRAA</div>
                                    <div style="font-size:15px; font-weight:bold; letter-spacing:5px; text-align:center; width:250px;">AUTO GROUP</div>
                                </td>
                                <td style="vertical-align:middle; text-align:right;">
                                    <t t-if="o.company_id.logo">
                                        <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height:80px; max-width:180px; display:block; margin-left:auto;"/>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <div style="background-color:#1a3a4a; color:white; padding:7px 10px; font-size:16px; font-weight:bold;">Customer Settlement Statement</div>

                        <!-- Info -->
                        <table style="width:100%; margin-top:2px;">
                            <tr>
                                <td style="padding:6px 8px; border-bottom:1px solid #ddd; width:50%;"><strong>Customer:</strong> <span t-field="o.customer_id.name"/></td>
                                <td style="padding:6px 8px; border-bottom:1px solid #ddd;"><strong>Contract No:</strong> <span t-field="o.name"/></td>
                            </tr>
                            <tr>
                                <td style="padding:6px 8px; border-bottom:1px solid #ddd;"><strong>Vehicle:</strong> <span t-field="o.vehicle_id.model_id.name"/></td>
                                <td style="padding:6px 8px; border-bottom:1px solid #ddd;"><strong>Plate No:</strong> <span t-field="o.vehicle_id.license_plate"/></td>
                            </tr>
                            <tr>
                                <td style="padding:6px 8px; border-bottom:1px solid #ddd;"><strong>Rent Start:</strong> <span t-field="o.rent_start_date"/></td>
                                <td style="padding:6px 8px; border-bottom:1px solid #ddd;"><strong>Rent End:</strong> <span t-field="o.rent_end_date"/></td>
                            </tr>
                            <tr>
                                <td style="padding:6px 8px; border-bottom:1px solid #ddd;"><strong>Actual Return:</strong> <span t-field="o.actual_return_date"/></td>
                                <td style="padding:6px 8px; border-bottom:1px solid #ddd;"><strong>Issue Date:</strong> <span t-out="datetime.date.today().strftime('%d-%m-%Y')"/></td>
                            </tr>
                        </table>

                        <!-- Section 1 -->
                        <div style="background-color:#1a3a4a; color:white; padding:6px 8px; font-weight:bold; margin-top:14px;">1 - Contract Charges</div>
                        <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; table-layout:fixed;">
                            <tr style="background-color:#eef3f5;">
                                <td style="padding:7px 9px; border:1px solid #ccc;"><strong>Description</strong></td>
                                <td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><strong>Amount (EGP)</strong></td>
                            </tr>
                            <tr><td style="padding:7px 9px; border:1px solid #ccc;">Rent Fees</td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><span t-field="o.rent_fees_amount"/></td></tr>
                            <tr><td style="padding:7px 9px; border:1px solid #ccc;">Pick Up Charges</td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><span t-field="o.pickup_charge_amount"/></td></tr>
                            <tr><td style="padding:7px 9px; border:1px solid #ccc;">Drop Off Charges</td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><span t-field="o.dropoff_charge_amount"/></td></tr>
                            <tr><td style="padding:7px 9px; border:1px solid #ccc;">Full Coverage Insurance</td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><span t-field="o.full_coverage_amount"/></td></tr>
                            <tr><td style="padding:7px 9px; border:1px solid #ccc;">Refundable Insurance <span style="font-size:11px; color:#555;">(Refundable)</span></td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><span t-field="o.insurance_amount"/></td></tr>
                            <tr style="background-color:#1a3a4a; color:white;"><td style="padding:7px 9px; border:1px solid #ccc;"><strong>Total Requested Charge</strong></td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><strong><span t-field="o.total_requested_charge"/></strong></td></tr>
                            <tr><td style="padding:7px 9px; border:1px solid #ccc;">Paid</td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right; color:#b00020;">- <span t-field="o.total_paid_amount"/></td></tr>
                            <tr style="background-color:#1a3a4a; color:white;"><td style="padding:7px 9px; border:1px solid #ccc;"><strong>Balance Due</strong></td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><strong><span t-field="o.balance_due"/></strong></td></tr>
                        </table>


                        <!-- Section: Deduction Details -->
                        <div style="background-color:#1a3a4a; color:white; padding:5px 8px; font-weight:bold; margin-top:10px;">Deduction Details</div>
                        <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; table-layout:fixed;">
                            <!-- مجموعة Extra KM -->
                            <tr style="background-color:#dde8ec;">
                                <td colspan="6" style="padding:3px 7px; border:1px solid #ccc;"><strong>Extra KM</strong></td>
                            </tr>
                            <tr>
                                <td style="padding:3px 7px; border:1px solid #ccc; background-color:#eef3f5;">Exit KM</td>
                                <td style="padding:3px 7px; border:1px solid #ccc; text-align:center;"><span t-field="o.exit_km"/></td>
                                <td style="padding:3px 7px; border:1px solid #ccc; background-color:#eef3f5;">Return KM</td>
                                <td style="padding:3px 7px; border:1px solid #ccc; text-align:center;"><span t-field="o.return_km"/></td>
                                <td style="padding:3px 7px; border:1px solid #ccc; background-color:#eef3f5;">Consumed KM</td>
                                <td style="padding:3px 7px; border:1px solid #ccc; text-align:center;"><span t-field="o.consumed_km"/></td>
                            </tr>
                            <tr>
                                <td style="padding:3px 7px; border:1px solid #ccc; background-color:#eef3f5;">Allowed KM/Day</td>
                                <td style="padding:3px 7px; border:1px solid #ccc; text-align:center;"><span t-field="o.km_per_day"/></td>
                                <td style="padding:3px 7px; border:1px solid #ccc; background-color:#eef3f5;">Extra KM</td>
                                <td style="padding:3px 7px; border:1px solid #ccc; text-align:center;"><span t-field="o.extra_km"/></td>
                                <td style="padding:3px 7px; border:1px solid #ccc; background-color:#eef3f5;">Extra KM Price</td>
                                <td style="padding:3px 7px; border:1px solid #ccc; text-align:center;"><span t-field="o.extra_km_price"/></td>
                            </tr>
                            <tr style="background-color:#2e5d3b; color:white;">
                                <td colspan="4" style="padding:3px 7px; border:1px solid #ccc;"><strong>Total Extra KM Charges</strong></td>
                                <td colspan="2" style="padding:3px 7px; border:1px solid #ccc; text-align:right;"><strong><span t-field="o.total_ex_km_amount"/> EGP</strong></td>
                            </tr>

                            <!-- مجموعة Extra Days -->
                            <tr style="background-color:#dde8ec;">
                                <td colspan="6" style="padding:3px 7px; border:1px solid #ccc;"><strong>Extra Days</strong></td>
                            </tr>
                            <tr>
                                <td style="padding:3px 7px; border:1px solid #ccc; background-color:#eef3f5;">Extra Days</td>
                                <td colspan="2" style="padding:3px 7px; border:1px solid #ccc; text-align:center;"><span t-field="o.extra_days"/></td>
                                <td style="padding:3px 7px; border:1px solid #ccc; background-color:#eef3f5;">Day Rate</td>
                                <td colspan="2" style="padding:3px 7px; border:1px solid #ccc; text-align:center;"><span t-field="o.day_rate"/></td>
                            </tr>
                            <tr style="background-color:#2e5d3b; color:white;">
                                <td colspan="4" style="padding:3px 7px; border:1px solid #ccc;"><strong>Total Extra Days Charges</strong></td>
                                <td colspan="2" style="padding:3px 7px; border:1px solid #ccc; text-align:right;"><strong><span t-out="abs(o.extra_days_amount)"/> EGP</strong></td>
                            </tr>

                            <!-- مجموعة Damages -->
                            <tr t-if="o.has_damages == 'yes'" style="background-color:#dde8ec;">
                                <td colspan="6" style="padding:3px 7px; border:1px solid #ccc;"><strong>Damages</strong></td>
                            </tr>
                            <tr t-if="o.has_damages == 'yes'">
                                <td style="padding:3px 7px; border:1px solid #ccc; background-color:#eef3f5;">Description</td>
                                <td colspan="5" style="padding:3px 7px; border:1px solid #ccc;"><span t-field="o.damage_description"/></td>
                            </tr>
                            <tr t-if="o.has_damages == 'yes'" style="background-color:#2e5d3b; color:white;">
                                <td colspan="4" style="padding:3px 7px; border:1px solid #ccc;"><strong>Estimated Damage Cost</strong></td>
                                <td colspan="2" style="padding:3px 7px; border:1px solid #ccc; text-align:right;"><strong><span t-field="o.estimated_cost"/> EGP</strong></td>
                            </tr>
                        </table>

                        <!-- Section 2 -->
                        <div style="background-color:#1a3a4a; color:white; padding:6px 8px; font-weight:bold; margin-top:14px;">2 - Insurance Settlement</div>
                        <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; table-layout:fixed;">
                            <tr style="background-color:#eef3f5;">
                                <td style="padding:7px 9px; border:1px solid #ccc;"><strong>Description</strong></td>
                                <td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><strong>Amount (EGP)</strong></td>
                            </tr>
                            <tr><td style="padding:7px 9px; border:1px solid #ccc;">Refundable Insurance <span style="font-size:11px; color:#1a3a4a;">(Paid by Customer)</span></td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><span t-field="o.insurance_amount"/></td></tr>
                            <tr><td style="padding:7px 9px; border:1px solid #ccc;">Less: Extra KM Charges</td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right; color:#b00020;">- <span t-field="o.total_ex_km_amount"/></td></tr>
                            <tr t-if="o.has_damages == 'yes'"><td style="padding:7px 9px; border:1px solid #ccc;">Less: Estimated Damage Cost</td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right; color:#b00020;">- <span t-field="o.estimated_cost"/></td></tr>
                            <tr><td style="padding:7px 9px; border:1px solid #ccc;">Less: Extra Days Charges</td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right; color:#b00020;">- <span t-out="abs(o.extra_days_amount)"/></td></tr>
                            <tr style="background-color:#1a3a4a; color:white;"><td style="padding:7px 9px; border:1px solid #ccc;"><strong>Net Insurance Refund</strong></td><td style="padding:7px 9px; border:1px solid #ccc; text-align:right;"><strong><span t-field="o.net_insurance_refund"/></strong></td></tr>
                        </table>

                        <!-- Final -->
                        <div style="background-color:#1a3a4a; color:white; padding:6px 8px; font-weight:bold; margin-top:14px;">Final Settlement</div>
                        <table style="width:100%; border-collapse:collapse; border:1px solid #ccc; table-layout:fixed;">
                            <tr><td style="padding:8px 10px; border:1px solid #ccc; width:60%;">Balance Due (from customer)</td><td style="padding:8px 10px; border:1px solid #ccc; text-align:right;"><span t-field="o.balance_due"/></td></tr>
                            <tr><td style="padding:8px 10px; border:1px solid #ccc;">Net Insurance Refund (to customer)</td><td style="padding:8px 10px; border:1px solid #ccc; text-align:right; color:#b00020;">- <span t-field="o.net_insurance_refund"/></td></tr>
                            <tr style="background-color:#1a3a4a; color:white;"><td style="padding:8px 10px; border:1px solid #ccc; font-size:15px;"><strong>Net Payable by Customer</strong></td><td style="padding:8px 10px; border:1px solid #ccc; text-align:right; font-size:15px;"><strong><span t-field="o.final_net_payable"/></strong></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>