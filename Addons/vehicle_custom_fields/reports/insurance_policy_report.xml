<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_insurance_policy" model="ir.actions.report">
        <field name="name">Insurance Policies</field>
        <field name="model">car.rental.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vehicle_custom_fields.report_insurance_policy_doc</field>
        <field name="report_file">vehicle_custom_fields.report_insurance_policy_doc</field>
        <field name="binding_model_id" ref="fleet_rental.model_car_rental_contract"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_rental_contract"/>
    </record>

    <!-- QWeb Template -->
    <template id="report_insurance_policy_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <!-- Insurance Page 1 -->
                    <div style="display:flex; flex-direction:column; min-height:285mm;">
                        <img src="/vehicle_custom_fields/static/src/img/insurance_page_1.png" style="width:100%; display:block;"/>
                    </div>
                    <!-- Insurance Page 2 -->
                    <div style="page-break-before:always; display:flex; flex-direction:column; min-height:285mm;">
                        <img src="/vehicle_custom_fields/static/src/img/insurance_page_2.png" style="width:100%; display:block;"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>