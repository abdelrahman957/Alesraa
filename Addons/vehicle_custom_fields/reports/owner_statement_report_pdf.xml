<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paper Format: Landscape -->
    <record id="paperformat_owner_statement" model="report.paperformat">
        <field name="name">Owner Statement Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_owner_statement" model="ir.actions.report">
        <field name="name">Owner Statement</field>
        <field name="model">owner.statement.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vehicle_custom_fields.report_owner_statement_document</field>
        <field name="report_file">vehicle_custom_fields.report_owner_statement_document</field>
        <field name="paperformat_id" ref="paperformat_owner_statement"/>
        <field name="binding_model_id" ref="model_owner_statement_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template -->
    <template id="report_owner_statement_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; color:#2c3e50; padding:0;">

                        <!-- HEADER -->
                        <table style="width:100%; border:none; border-collapse:collapse; margin-bottom:8px;">
                            <tr style="border:none;">
                                <td style="border:none; vertical-align:middle; width:50%;">
                                    <img t-if="o.company_id.logo"
                                         t-att-src="image_data_uri(o.company_id.logo)"
                                         style="height:52px;"/>
                                </td>
                                <td style="border:none; vertical-align:middle; text-align:right; width:50%;">
                                    <div style="font-size:26px; font-weight:300; letter-spacing:3px; color:#1a3a4a; line-height:1.1;">OWNER STATEMENT</div>
                                    <div style="font-size:12px; color:#8899a6; letter-spacing:2px; margin-top:2px;"><span t-field="o.name"/></div>
                                </td>
                            </tr>
                        </table>
                        <div style="height:2px; background:#1a3a4a; margin-bottom:28px;"></div>

                        <!-- INFO STRIP -->
                        <table style="width:100%; border:none; border-collapse:collapse; margin-bottom:30px;">
                            <tr style="border:none;">
                                <td style="border:none; width:28%; padding:0 20px 0 0;">
                                    <div style="font-size:9px; color:#a0aab3; letter-spacing:1.5px; margin-bottom:3px;">OWNER</div>
                                    <div style="font-size:14px; font-weight:600; color:#1a3a4a;"><span t-field="o.owner_id.name"/></div>
                                </td>
                                <td style="border:none; width:28%; padding:0 20px 0 0;">
                                    <div style="font-size:9px; color:#a0aab3; letter-spacing:1.5px; margin-bottom:3px;">VEHICLE</div>
                                    <div style="font-size:14px; font-weight:600; color:#1a3a4a;"><span t-field="o.vehicle_id.name"/></div>
                                </td>
                                <td style="border:none; width:28%; padding:0 20px 0 0;">
                                    <div style="font-size:9px; color:#a0aab3; letter-spacing:1.5px; margin-bottom:3px;">PERIOD</div>
                                    <div style="font-size:14px; font-weight:600; color:#1a3a4a;">
                                        <span t-field="o.date_from" t-options="{'widget': 'date'}"/> &#8212; <span t-field="o.date_to" t-options="{'widget': 'date'}"/>
                                    </div>
                                </td>
                                <td style="border:none; width:16%; text-align:right;">
                                    <div style="font-size:9px; color:#a0aab3; letter-spacing:1.5px; margin-bottom:3px;">STATUS</div>
                                    <div t-if="o.is_paid" style="font-size:14px; font-weight:700; color:#27a567; letter-spacing:1px;">PAID</div>
                                    <div t-elif="o.state == 'confirmed'" style="font-size:14px; font-weight:600; color:#1a3a4a;">Confirmed</div>
                                    <div t-else="" style="font-size:14px; font-weight:600; color:#a0aab3;">Draft</div>
                                </td>
                            </tr>
                        </table>

                        <!-- LINES -->
                        <table style="width:100%; border:none; border-collapse:collapse;">
                            <thead>
                                <tr style="border:none;">
                                    <th style="border:none; border-bottom:2px solid #1a3a4a; padding:0 0 8px 0; text-align:left; font-size:9px; font-weight:600; letter-spacing:1.5px; color:#8899a6; width:16%;">TYPE</th>
                                    <th style="border:none; border-bottom:2px solid #1a3a4a; padding:0 0 8px 0; text-align:left; font-size:9px; font-weight:600; letter-spacing:1.5px; color:#8899a6; width:14%;">DATE</th>
                                    <th style="border:none; border-bottom:2px solid #1a3a4a; padding:0 0 8px 0; text-align:left; font-size:9px; font-weight:600; letter-spacing:1.5px; color:#8899a6;">DESCRIPTION</th>
                                    <th style="border:none; border-bottom:2px solid #1a3a4a; padding:0 0 8px 0; text-align:right; font-size:9px; font-weight:600; letter-spacing:1.5px; color:#8899a6; width:18%;">AMOUNT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line" style="border:none;">
                                    <td style="border:none; border-bottom:1px solid #eef2f5; padding:12px 0; font-size:12.5px; color:#2c3e50;">
                                        <span t-if="line.line_type == 'rent_cost'">Rent Cost</span>
                                        <span t-elif="line.line_type == 'service'">Service</span>
                                        <span t-else="">Other</span>
                                    </td>
                                    <td style="border:none; border-bottom:1px solid #eef2f5; padding:12px 0; font-size:12.5px; color:#6b7c8c;">
                                        <span t-field="line.date" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td style="border:none; border-bottom:1px solid #eef2f5; padding:12px 0; font-size:12.5px; color:#6b7c8c;">
                                        <span t-field="line.description"/>
                                    </td>
                                    <td t-attf-style="border:none; border-bottom:1px solid #eef2f5; padding:12px 0; font-size:13px; text-align:right; font-weight:600; color:#{'c0392b' if line.amount &lt; 0 else '2c3e50'};">
                                        <span t-esc="'{:,.2f}'.format(line.amount)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- TOTAL -->
                        <table style="width:100%; border:none; border-collapse:collapse; margin-top:24px;">
                            <tr style="border:none;">
                                <td style="border:none; width:62%;"></td>
                                <td style="border:none; padding:16px 0 0 0;">
                                    <table style="width:100%; border:none; border-collapse:collapse;">
                                        <tr style="border:none;">
                                            <td style="border:none; border-top:2px solid #1a3a4a; padding:12px 0 0 0; font-size:11px; font-weight:600; letter-spacing:2px; color:#8899a6;">TOTAL DUE</td>
                                            <td style="border:none; border-top:2px solid #1a3a4a; padding:12px 0 0 0; text-align:right;">
                                                <span style="font-size:22px; font-weight:700; color:#1a3a4a;"><span t-esc="'{:,.2f}'.format(o.total_amount)"/></span>
                                                <span style="font-size:11px; color:#8899a6; margin-left:4px;">EGP</span>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- SIGNATURE -->
                        <table style="width:100%; border:none; border-collapse:collapse; margin-top:70px;">
                            <tr style="border:none;">
                                <td style="border:none; width:35%;">
                                    <div style="border-top:1px solid #c5cdd4; padding-top:8px; font-size:10px; color:#8899a6; letter-spacing:1px;">OWNER SIGNATURE</div>
                                </td>
                                <td style="border:none; width:30%;"></td>
                                <td style="border:none; width:35%;">
                                    <div style="border-top:1px solid #c5cdd4; padding-top:8px; font-size:10px; color:#8899a6; letter-spacing:1px; text-align:right;">
                                        <span t-field="o.company_id.name"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>