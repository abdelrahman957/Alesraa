<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paper Format: Landscape -->
    <record id="paperformat_owner_statement" model="report.paperformat">
        <field name="name">Owner Statement Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_owner_statement" model="ir.actions.report">
        <field name="name">Owner Statement</field>
        <field name="model">owner.statement.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vehicle_custom_fields.report_owner_statement_document</field>
        <field name="report_file">vehicle_custom_fields.report_owner_statement_document</field>
        <field name="paperformat_id" ref="paperformat_owner_statement"/>
        <field name="binding_model_id" ref="model_owner_statement_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template -->
    <template id="report_owner_statement_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <style>
                            .os-wrap * { border: none !important; box-sizing: border-box; }
                            .os-wrap { font-family: Helvetica, Arial, sans-serif; color: #2c3e50; }
                            .os-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; }
                            .os-rule { height: 2px; background: #1a3a4a; margin-bottom: 30px; }
                            .os-title { font-size: 26px; font-weight: 300; letter-spacing: 4px; color: #1a3a4a; text-align: right; line-height: 1.1; }
                            .os-ref { font-size: 11px; color: #98a5b0; letter-spacing: 2px; text-align: right; margin-top: 3px; }
                            .os-info { display: flex; margin-bottom: 34px; }
                            .os-cell { flex: 1; padding-right: 24px; }
                            .os-cell:last-child { padding-right: 0; text-align: right; }
                            .os-lbl { font-size: 8.5px; color: #b0bac2; letter-spacing: 1.5px; margin-bottom: 4px; }
                            .os-val { font-size: 13.5px; font-weight: bold; color: #1a3a4a; }
                            .os-paid { font-size: 13.5px; font-weight: bold; color: #27a567; letter-spacing: 1px; }
                            .os-row { display: flex; padding: 11px 0; }
                            .os-hdr { display: flex; padding: 0 0 9px 0; border-bottom: 2px solid #1a3a4a !important; }
                            .os-hdr div { font-size: 8.5px; font-weight: bold; letter-spacing: 1.5px; color: #98a5b0; }
                            .os-line { border-bottom: 1px solid #eef2f5 !important; }
                            .c1 { width: 16%; } .c2 { width: 15%; } .c3 { flex: 1; } .c4 { width: 20%; text-align: right; }
                            .os-row .c1 { font-size: 12px; color: #2c3e50; }
                            .os-row .c2, .os-row .c3 { font-size: 12px; color: #7a8894; }
                            .os-row .c4 { font-size: 12.5px; font-weight: bold; }
                            .os-total { display: flex; justify-content: flex-end; margin-top: 26px; }
                            .os-tbox { width: 38%; border-top: 2px solid #1a3a4a !important; padding-top: 13px; display: flex; justify-content: space-between; align-items: baseline; }
                            .os-tlbl { font-size: 10px; font-weight: bold; letter-spacing: 2px; color: #98a5b0; }
                            .os-tval { font-size: 21px; font-weight: bold; color: #1a3a4a; }
                            .os-cur { font-size: 10px; color: #98a5b0; margin-left: 4px; }
                            .os-sign { display: flex; justify-content: space-between; margin-top: 90px; }
                            .os-sbox { width: 34%; border-top: 1px solid #ccd4da !important; padding-top: 9px; font-size: 9px; color: #98a5b0; letter-spacing: 1px; }
                            .os-sbox.right { text-align: right; }
                        </style>

                        <div class="os-wrap">
                            <div class="os-head">
                                <div>
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="height:50px;"/>
                                </div>
                                <div>
                                    <div class="os-title">OWNER STATEMENT</div>
                                    <div class="os-ref"><span t-field="o.name"/></div>
                                </div>
                            </div>
                            <div class="os-rule"></div>

                            <div class="os-info">
                                <div class="os-cell">
                                    <div class="os-lbl">OWNER</div>
                                    <div class="os-val"><span t-field="o.owner_id.name"/></div>
                                </div>
                                <div class="os-cell">
                                    <div class="os-lbl">VEHICLE</div>
                                    <div class="os-val"><span t-field="o.vehicle_id.name"/></div>
                                </div>
                                <div class="os-cell">
                                    <div class="os-lbl">PERIOD</div>
                                    <div class="os-val">
                                        <span t-field="o.date_from" t-options="{'widget': 'date'}"/> &#8212; <span t-field="o.date_to" t-options="{'widget': 'date'}"/>
                                    </div>
                                </div>
                                <div class="os-cell">
                                    <div class="os-lbl">STATUS</div>
                                    <div t-if="o.is_paid" class="os-paid">PAID</div>
                                    <div t-elif="o.state == 'confirmed'" class="os-val">Confirmed</div>
                                    <div t-else="" class="os-val" style="color:#b0bac2;">Draft</div>
                                </div>
                            </div>

                            <div class="os-hdr">
                                <div class="c1">TYPE</div>
                                <div class="c2">DATE</div>
                                <div class="c3">DESCRIPTION</div>
                                <div class="c4">AMOUNT</div>
                            </div>

                            <div t-foreach="o.line_ids" t-as="line" class="os-row os-line">
                                <div class="c1">
                                    <span t-if="line.line_type == 'rent_cost'">Rent Cost</span>
                                    <span t-elif="line.line_type == 'service'">Service</span>
                                    <span t-else="">Other</span>
                                </div>
                                <div class="c2"><span t-field="line.date" t-options="{'widget': 'date'}"/></div>
                                <div class="c3"><span t-field="line.description"/></div>
                                <div class="c4" t-attf-style="color:#{'c0392b' if line.amount &lt; 0 else '2c3e50'};">
                                    <span t-esc="'{:,.2f}'.format(line.amount)"/>
                                </div>
                            </div>

                            <div class="os-total">
                                <div class="os-tbox">
                                    <div class="os-tlbl">TOTAL DUE</div>
                                    <div>
                                        <span class="os-tval"><span t-esc="'{:,.2f}'.format(o.total_amount)"/></span><span class="os-cur">EGP</span>
                                    </div>
                                </div>
                            </div>

                            <div class="os-sign">
                                <div class="os-sbox">OWNER SIGNATURE</div>
                                <div class="os-sbox right"><span t-field="o.company_id.name"/></div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>