<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paper Format: Landscape -->
    <record id="paperformat_owner_statement" model="report.paperformat">
        <field name="name">Owner Statement Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_owner_statement" model="ir.actions.report">
        <field name="name">Owner Statement</field>
        <field name="model">owner.statement.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vehicle_custom_fields.report_owner_statement_document</field>
        <field name="report_file">vehicle_custom_fields.report_owner_statement_document</field>
        <field name="paperformat_id" ref="paperformat_owner_statement"/>
        <field name="binding_model_id" ref="model_owner_statement_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template -->
    <template id="report_owner_statement_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <style>
                            .osw table, .osw thead, .osw tbody, .osw tr, .osw td, .osw th {
                                border:0 !important;
                                border-width:0 !important;
                                border-style:none !important;
                                border-color:transparent !important;
                                border-collapse:collapse !important;
                                background-image:none !important;
                            }
                            .osw table { width:100%; }
                            .osw { font-family: Helvetica, Arial, sans-serif; color:#1c2b38; }
                            .osw .brand-1 { font-size:23px; letter-spacing:5px; color:#12384d; font-weight:bold; line-height:1.1; }
                            .osw .brand-2 { font-size:11.5px; letter-spacing:4px; color:#5b7183; font-weight:bold; }
                            .osw .title { font-size:19px; font-weight:300; letter-spacing:4px; color:#12384d; line-height:1.1; }
                            .osw .ref { font-size:11px; letter-spacing:2px; color:#5b7183; font-weight:bold; padding-top:5px; }
                            .osw .rule { height:3px; background:#12384d; font-size:0; line-height:0; }
                            .osw .lbl { font-size:9px; letter-spacing:1.6px; color:#5b7183; font-weight:bold; padding-bottom:5px; }
                            .osw .val { font-size:14px; font-weight:bold; color:#12384d; }
                            .osw .val.paid { color:#15803d; letter-spacing:1px; }
                            .osw .val.draft { color:#7d8d9b; }
                            .osw .th { background:#12384d !important; padding:12px !important; font-size:11.5px; font-weight:bold; letter-spacing:2px; color:#ffffff !important; }
                            .osw .td { padding:13px 12px !important; border-bottom:1px solid #c9d3db !important; font-size:12.5px; }
                            .osw .td.b { font-weight:bold; color:#1c2b38; }
                            .osw .td.g { color:#425466; }
                            .osw .td.amt { font-size:13px; font-weight:bold; color:#1c2b38; text-align:right; }
                            .osw .td.amt.neg { color:#b91c1c; }
                            .osw .tlbl { font-size:10px; font-weight:bold; letter-spacing:2px; color:#12384d; border-top:2px solid #12384d !important; padding-top:14px !important; }
                            .osw .tval { font-size:22px; font-weight:bold; color:#12384d; border-top:2px solid #12384d !important; padding-top:14px !important; text-align:right; }
                            .osw .cur { font-size:10px; color:#5b7183; font-weight:bold; }
                            .osw .sbox { border-top:1px solid #8fa0ad !important; padding-top:9px !important; font-size:9.5px; letter-spacing:1.4px; color:#5b7183; font-weight:bold; }
                        </style>

                        <div class="osw">
                            <!-- HEADER -->
                            <table style="width:100%;">
                                <tr>
                                    <td style="width:70px; vertical-align:middle;">
                                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="height:54px;"/>
                                    </td>
                                    <td style="vertical-align:middle; padding-left:14px;">
                                        <div class="brand-1">ALESRAA</div>
                                        <div class="brand-2">AUTO GROUP</div>
                                    </td>
                                    <td style="vertical-align:middle; text-align:right;">
                                        <div class="title">OWNER STATEMENT</div>
                                        <div class="ref"><span t-field="o.name"/></div>
                                    </td>
                                </tr>
                            </table>
                            <div class="rule" style="margin:14px 0 26px;">&#160;</div>

                            <!-- INFO -->
                            <table style="width:100%; margin-bottom:26px;">
                                <tr>
                                    <td style="width:25%;"><div class="lbl">OWNER</div></td>
                                    <td style="width:25%;"><div class="lbl">VEHICLE</div></td>
                                    <td style="width:30%;"><div class="lbl">PERIOD</div></td>
                                    <td style="width:20%; text-align:right;"><div class="lbl">STATUS</div></td>
                                </tr>
                                <tr>
                                    <td><div class="val"><span t-field="o.owner_id.name"/></div></td>
                                    <td><div class="val"><span t-field="o.vehicle_id.name"/></div></td>
                                    <td><div class="val"><span t-field="o.date_from" t-options="{'widget': 'date'}"/> &#8212; <span t-field="o.date_to" t-options="{'widget': 'date'}"/></div></td>
                                    <td style="text-align:right;">
                                        <div t-if="o.is_paid" class="val paid">PAID</div>
                                        <div t-elif="o.state == 'confirmed'" class="val">Confirmed</div>
                                        <div t-else="" class="val draft">Draft</div>
                                    </td>
                                </tr>
                            </table>

                            <!-- LINES -->
                            <table style="width:100%;">
                                <thead>
                                    <tr>
                                        <th class="th" style="width:15%; text-align:left;">TYPE</th>
                                        <th class="th" style="width:14%; text-align:left;">DATE</th>
                                        <th class="th" style="text-align:left;">DESCRIPTION</th>
                                        <th class="th" style="width:18%; text-align:right;">AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.line_ids" t-as="line">
                                        <td class="td b">
                                            <span t-if="line.line_type == 'rent_cost'">Rent Cost</span>
                                            <span t-elif="line.line_type == 'service'">Service</span>
                                            <span t-else="">Other</span>
                                        </td>
                                        <td class="td g"><span t-field="line.date" t-options="{'widget': 'date'}"/></td>
                                        <td class="td g"><span t-field="line.description"/></td>
                                        <td t-attf-class="td amt #{'neg' if line.amount &lt; 0 else ''}">
                                            <span t-esc="'{:,.2f}'.format(line.amount)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- TOTAL -->
                            <table style="width:100%; margin-top:22px;">
                                <tr>
                                    <td style="width:64%;">&#160;</td>
                                    <td class="tlbl" style="width:16%;">TOTAL DUE</td>
                                    <td class="tval" style="width:20%;">
                                        <span t-esc="'{:,.2f}'.format(o.total_amount)"/><span class="cur"> EGP</span>
                                    </td>
                                </tr>
                            </table>

                            <!-- SIGNATURE -->
                            <table style="width:100%; margin-top:80px;">
                                <tr>
                                    <td class="sbox" style="width:32%;">OWNER SIGNATURE</td>
                                    <td style="width:68%;">&#160;</td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>