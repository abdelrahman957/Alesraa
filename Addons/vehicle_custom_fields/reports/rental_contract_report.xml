<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Action -->
    <record id="action_report_rental_contract" model="ir.actions.report">
        <field name="name">Rental Agreement</field>
        <field name="model">car.rental.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vehicle_custom_fields.report_rental_contract_doc</field>
        <field name="report_file">vehicle_custom_fields.report_rental_contract_doc</field>
        <field name="binding_model_id" ref="fleet_rental.model_car_rental_contract"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_rental_contract_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 11px;">

                        <!-- Header Logo -->
                        <div style="text-align:center; margin-bottom:8px;">
                            <span style="font-size:28px; font-weight:bold; letter-spacing:6px;">ALESRAA</span><br/>
                            <span style="font-size:12px; letter-spacing:3px;">AUTO GROUP</span>
                        </div>

                        <div style="text-align:center; font-size:10px;">- 1 -</div>

                        <!-- Agreement intro -->
                        <table style="width:100%; background-color:#1a3a4a; color:white; padding:4px;">
                            <tr>
                                <td style="padding:4px;">
                                    <u>This rental agreement is made on ____-____-2026 between:</u><br/>
                                    <strong>First Party (The Lessor):</strong>
                                </td>
                                <td style="padding:4px; text-align:right; direction:rtl;">
                                    <u>انه في يوم ____-____-2026 تم الإتفاق بين كلا من:</u><br/>
                                    <strong>طرف اول (مؤجر):</strong>
                                </td>
                            </tr>
                        </table>

                        <!-- Lessor Info -->
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="padding:3px;"><strong>Name:</strong> <span t-field="o.company_id.name"/></td>
                                <td style="padding:3px; text-align:right; direction:rtl;"><strong>الأسم</strong></td>
                            </tr>
                            <tr>
                                <td style="padding:3px;"><strong>Address:</strong> <span t-field="o.company_id.partner_id.contact_address"/></td>
                                <td style="padding:3px; text-align:right; direction:rtl;"><strong>العنوان</strong></td>
                            </tr>
                        </table>

                        <!-- Lessee Header -->
                        <table style="width:100%; background-color:#1a3a4a; color:white;">
                            <tr>
                                <td style="padding:4px;"><strong>Second Party (The lessee):</strong></td>
                                <td style="padding:4px; text-align:right; direction:rtl;"><strong>طرف ثاني (مستأجر):</strong></td>
                            </tr>
                        </table>

                        <!-- Lessee Info -->
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="padding:3px;"><strong>Full Name:</strong> <span t-field="o.customer_id.name"/></td>
                                <td style="padding:3px;"></td>
                                <td style="padding:3px; text-align:right; direction:rtl;"><strong>الأسم</strong></td>
                            </tr>
                            <tr>
                                <td style="padding:3px;"><strong>Telephone Number:</strong> <span t-field="o.customer_id.phone"/></td>
                                <td style="padding:3px;"><strong>ID No:</strong> <span t-field="o.customer_id.vat"/></td>
                                <td style="padding:3px;"><strong>Valid Till:</strong></td>
                            </tr>
                            <tr>
                                <td style="padding:3px;"><strong>Address:</strong> <span t-field="o.customer_id.contact_address"/></td>
                                <td style="padding:3px;"><strong>DL No:</strong></td>
                                <td style="padding:3px;"><strong>Valid Till:</strong></td>
                            </tr>
                        </table>

                        <!-- Vehicle Header -->
                        <table style="width:100%; background-color:#1a3a4a; color:white;">
                            <tr>
                                <td style="padding:4px;"><strong>Rented Vehicle Details:</strong></td>
                            </tr>
                        </table>

                        <!-- Vehicle Info -->
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="padding:3px;"><strong>Car Type:</strong> <span t-field="o.vehicle_id.model_id.brand_id.name"/></td>
                                <td style="padding:3px;"><strong>Code:</strong></td>
                            </tr>
                            <tr>
                                <td style="padding:3px;"><strong>Model:</strong> <span t-field="o.vehicle_id.model_id.name"/></td>
                                <td style="padding:3px;"><strong>Chassis:</strong> <span t-field="o.vehicle_id.vin_sn"/></td>
                                <td style="padding:3px;"><strong>Exit Km:</strong> <span t-field="o.vehicle_id.odometer"/></td>
                            </tr>
                            <tr>
                                <td style="padding:3px;"><strong>Plate No:</strong> <span t-field="o.vehicle_id.license_plate"/></td>
                                <td style="padding:3px;"><strong>Engine:</strong> <span t-field="o.vehicle_id.motor_number"/></td>
                                <td style="padding:3px;"><strong>Exit Fuel:</strong> <span t-field="o.vehicle_id.fuel_type"/></td>
                            </tr>
                        </table>

                        <!-- Charge Summary Header -->
                        <table style="width:100%; background-color:#1a3a4a; color:white;">
                            <tr><td style="padding:4px;"><strong>Charge Summary</strong></td></tr>
                        </table>

                        <!-- Charge Summary Body: Image (left) + Pickup/Dropoff + Summary (right) -->
                        <table style="width:100%; border-collapse:collapse; margin-top:8px;">
                            <tr>
                                <!-- Vehicle Image on the left -->
                                <td style="width:45%; vertical-align:top; text-align:center; padding:8px;">
                                    <t t-if="o.vehicle_id.image_128">
                                        <img t-att-src="image_data_uri(o.vehicle_id.image_1920)"
                                             style="max-width:100%; max-height:250px;"/>
                                    </t>
                                </td>
                                <!-- Pickup / Dropoff + Summary on the right -->
                                <td style="width:55%; vertical-align:top;">
                                    <table style="width:100%; border-collapse:collapse;">
                                        <tr style="background-color:#eef3f5;">
                                            <td style="padding:3px;"></td>
                                            <td style="padding:3px; text-align:center;"><strong>Pick Up</strong></td>
                                            <td style="padding:3px; text-align:center;"><strong>Drop Off</strong></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:3px;"><strong>Location:</strong></td>
                                            <td style="padding:3px;"><span t-field="o.delivery_location"/></td>
                                            <td style="padding:3px;"></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:3px;"><strong>Date:</strong></td>
                                            <td style="padding:3px;"><span t-field="o.rent_start_date"/></td>
                                            <td style="padding:3px;"><span t-field="o.rent_end_date"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding:3px;"><strong>Time:</strong></td>
                                            <td style="padding:3px;"><span t-field="o.start_time"/></td>
                                            <td style="padding:3px;"><span t-field="o.end_time"/></td>
                                        </tr>
                                        <tr style="background-color:#eef3f5;">
                                            <td colspan="3" style="padding:3px; text-align:center;"><strong>Summary</strong></td>
                                        </tr>
                                        <tr style="background-color:#fdf6e3;">
                                            <td style="padding:3px;"><strong>Rental Period:</strong></td>
                                            <td style="padding:3px;" colspan="2">
                                                <span t-field="o.rental_period_days"/> Days
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Daily Rate Notes -->
                        <table style="width:100%; margin-top:8px; font-size:10px;">
                            <tr>
                                <td>
                                    <u><strong>The Daily Rate Above Includes:</strong></u>
                                    <ul style="margin:2px 0;">
                                        <li>Basic Insurance Policy</li>
                                        <li>Free 150 KM/Day</li>
                                    </ul>
                                    <u><strong>The Daily Rate Above Excludes:</strong></u>
                                    <ul style="margin:2px 0;">
                                        <li>Any Fuel you use during the rental</li>
                                        <li>Any excess KMS after 150 KM/Day, 7 LE/KM</li>
                                    </ul>
                                </td>
                            </tr>
                        </table>

                        <!-- Signatures -->
                        <table style="width:100%; background-color:#1a3a4a; color:white; margin-top:12px;">
                            <tr>
                                <td style="padding:4px;"><strong>First Party</strong></td>
                                <td style="padding:4px;"><strong>Second Party</strong></td>
                            </tr>
                        </table>
                        <table style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="padding:3px;"><strong>Name:</strong></td>
                                <td style="padding:3px;"><strong>Name:</strong></td>
                            </tr>
                            <tr>
                                <td style="padding:3px;"><strong>Signature:</strong></td>
                                <td style="padding:3px;"><strong>Signature:</strong></td>
                            </tr>
                            <tr>
                                <td style="padding:3px;"><strong>Date:</strong></td>
                                <td style="padding:3px;"><strong>Date:</strong></td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>