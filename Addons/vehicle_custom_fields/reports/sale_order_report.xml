<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_sale_order_custom" inherit_id="sale.report_saleorder_document">

        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_image" class="text-center">Image</th>
        </xpath>

        <xpath expr="//td[@name='td_product_quantity']" position="before">
            <td name="td_product_image" class="text-center">
                <t t-if="line.product_id.image_1920">
                    <img t-att-src="image_data_uri(line.product_id.image_1920)"
                    style="max-height:250px; max-width:250px; background-color:#ffffff;"/>
                </t>
            </td>
        </xpath>

        <xpath expr="//div[@id='informations']" position="before">
            <table class="table table-bordered mb-4">
                <tr>
                    <td><strong>Pick Up Location:</strong><br/><span t-field="doc.pickup_location"/></td>
                    <td><strong>Drop Off Location:</strong><br/><span t-field="doc.dropoff_location"/></td>
                    <td><strong>From:</strong><br/><span t-field="doc.rental_date_from"/></td>
                    <td><strong>To:</strong><br/><span t-field="doc.rental_date_to"/></td>
                    <td><strong>Duration in Days:</strong><br/><span t-field="doc.rental_duration"/></td>
                </tr>
            </table>
        </xpath>

    </template>

</odoo>