<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_sale_order_custom" inherit_id="sale.report_saleorder_document">

        <!-- Add Image column header after Description -->
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_image" class="text-center">Image</th>
        </xpath>

        <!-- Add Image cell after description cell in each line -->
        <xpath expr="//td[@name='td_product_subtotal']" position="before">
            <td name="td_product_image" class="text-center">
                <t t-if="line.product_id.image_128">
                    <img t-att-src="image_data_uri(line.product_id.image_128)"
                         style="max-height:60px; max-width:80px;"/>
                </t>
            </td>
        </xpath>

        <!-- Add Rental info table after document header -->
        <xpath expr="//div[@id='informations']" position="after">
            <table class="table table-bordered" style="margin-bottom:16px;">
                <tr>
                    <td>
                        <strong>Delivery Location:</strong><br/>
                        <span t-field="o.delivery_location"/>
                    </td>
                    <td>
                        <strong>From:</strong><br/>
                        <span t-field="o.rental_date_from"/>
                    </td>
                    <td>
                        <strong>To:</strong><br/>
                        <span t-field="o.rental_date_to"/>
                    </td>
                    <td>
                        <strong>Duration in Days:</strong><br/>
                        <span t-field="o.rental_duration"/>
                    </td>
                </tr>
            </table>
        </xpath>

    </template>

</odoo>