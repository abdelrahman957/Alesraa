<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format -->
    <record id="paperformat_service_report" model="report.paperformat">
        <field name="name">Service Report Format</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_service" model="ir.actions.report">
        <field name="name">تقرير صيانة</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vehicle_custom_fields.report_service_document</field>
        <field name="report_file">vehicle_custom_fields.report_service_document</field>
        <field name="binding_model_id" ref="fleet.model_fleet_vehicle_log_services"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_service_report"/>
    </record>

    <!-- Report Template -->
    <template id="report_service_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <!-- Article (body) -->
                <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
                    <div class="page" style="font-family:'Noto Sans Arabic', sans-serif; color:#2c3e50; direction:rtl;"> 
                       <style>
                            table, td, th { border:0 !important; }
                            .srv-grid td { border:1px solid #e3e9ef !important; }
                            .srv-table tbody td { border-bottom:1px solid #eef1f4 !important; }
                            .srv-header { background:#ffffff; color:#1a3a4a; padding:15px 35px 20px; border-bottom:4px solid #1a3a4a; }
                            .srv-header table { width:100%; border:none; }
                            .srv-header td { border:none; vertical-align:middle; }
                            .srv-header h1 { font-size:28px; font-weight:900; margin:0; color:#1a3a4a; }
                            .srv-meta { background:#f5b800; color:#1a3a4a; padding:10px 35px; font-size:13px; font-weight:600; }
                            .srv-meta table { width:100%; border:none; }
                            .srv-meta td { border:none; }
                            .srv-content { padding:30px 35px; }
                            .srv-section { margin-bottom:28px; }
                            .srv-title { font-size:16px; font-weight:700; color:#1a3a4a; margin-bottom:12px; padding-right:12px; border-right:4px solid #f5b800; }
                            .srv-grid { width:100%; border:none; border-collapse:separate; border-spacing:8px; table-layout:fixed; }
                            .srv-grid td { background:#eef2f6; border:1px solid #e3e9ef; border-radius:6px; padding:12px 15px; width:50%; vertical-align:top; }                            
                            .srv-card .lbl { font-size:12px; color:#7a8a99; margin-bottom:3px; }
                            .srv-card .val { font-size:15px; font-weight:600; color:#1a3a4a; direction:rtl; text-align:right; overflow-wrap:break-word; }
                            .srv-table { width:100%; border-collapse:collapse; }
                            .srv-table, .srv-table tr, .srv-table td, .srv-table th { border:0 !important; }
                            .srv-table * { border-color:transparent !important; }
                            .srv-table tbody td { border-bottom:1px solid #eef1f4 !important; }
                            .srv-table thead th { background:#1a3a4a; color:#fff; padding:12px 15px; font-size:13px; text-align:right; font-weight:700; }                            
                            .srv-table tbody td { padding:12px 15px; font-size:13px; border-bottom:1px solid #eef1f4; direction:rtl; text-align:right; overflow-wrap:break-word; }
                            .srv-total { background:#1a3a4a; color:#fff; padding:14px 30px; border-radius:6px; display:inline-block; margin-top:18px; }
                            .srv-total .tl { font-size:15px; font-weight:600; }
                            .srv-total .tv { font-size:22px; font-weight:900; color:#f5b800; padding-right:25px; }
                            .srv-notes { background:#fffbe6; border:1px dashed #e0c870; border-radius:6px; padding:15px; font-size:13px; color:#6b5d2f; }
                        </style>

                        <!-- Header -->
                        <div class="srv-header">
                            <div style="display:table; width:100%;">
                                <div style="display:table-cell; text-align:right; vertical-align:middle;"><h1>تقرير صيانة</h1></div>
                                <div style="display:table-cell; text-align:left; vertical-align:middle; width:180px;">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height:80px; max-width:180px;"/>
                                </div>
                            </div>
                        </div>

                        <!-- Meta -->
                        <div class="srv-meta">
                            <div style="text-align:right;">تاريخ الطباعة: <span dir="ltr" t-out="datetime.date.today().strftime('%d/%m/%Y')"/></div>
                        </div>

                        <div class="srv-content">
                            <!-- Vehicle Info -->
                            <div class="srv-section">
                                <div class="srv-title">بيانات السيارة</div>
                                <table class="srv-grid">
                                    <tr>
                                        <td class="srv-card"><div class="lbl">الماركة / الموديل</div><div class="val"><span t-out="o.vehicle_id.brand_id.name"/> / <span t-out="o.vehicle_id.model_id.name"/></div></td>
                                        <td class="srv-card"><div class="lbl">سنة الصنع</div><div class="val"><span t-out="o.vehicle_id.model_year"/></div></td>
                                    </tr>
                                    <tr>
                                        <td class="srv-card"><div class="lbl">رقم اللوحة</div><div class="val">&#8207;<span t-out="o.vehicle_id.license_plate"/>&#8207;</div></td>
                                        <td class="srv-card"><div class="lbl">رقم الشاسيه</div><div class="val"><span t-out="o.vehicle_id.vin_sn"/></div></td>
                                    </tr>
                                    <tr>
                                        <td class="srv-card"><div class="lbl">قراءة العداد</div><div class="val"><span t-out="o.odometer"/> كم</div></td>
                                        <td class="srv-card"><div class="lbl">السائق</div><div class="val"><span t-out="o.purchaser_id.name"/></div></td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Service Info -->
                            <div class="srv-section">
                                <div class="srv-title">تفاصيل الصيانة</div>
                                <table class="srv-grid">
                                    <tr>
                                        <td class="srv-card">
                                            <div class="lbl">النوع</div>
                                            <div class="val">
                                                <t t-if="o.service_category == 'periodic'">صيانة دورية</t>
                                                <t t-if="o.service_category == 'accident'">حادث</t>
                                            </div>
                                        </td>
                                        <td class="srv-card">
                                            <div class="lbl">التاريخ</div>
                                            <div class="val"><span t-out="o.date" t-options="{'widget': 'date'}"/></div>
                                        </td>
                                    </tr>
                                </table>
                                <table class="srv-grid">
                                    <tr>
                                        <td class="srv-card"><div class="lbl">الوصف</div><div class="val">&#8207;<span t-out="o.description"/>&#8207;</div></td>
                                        <td class="srv-card"><div class="lbl">المورّد / الورشة</div><div class="val"><span t-out="o.vendor_id.name"/></div></td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Lines -->
                            <div class="srv-section">
                                <div class="srv-title">بنود الصيانة</div>
                                <table class="srv-table">
                                    <thead>
                                        <tr>
                                            <th style="width:24%;">نوع الخدمة</th>
                                            <th>الوصف</th>
                                            <th t-if="o.service_category == 'periodic'" style="width:16%;">المسؤول</th>
                                            <th style="text-align:left; width:20%;">المبلغ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="o.service_line_ids" t-as="line">
                                            <td><span t-out="line.service_type_id.name"/></td>
                                            <td>&#8207;<span t-out="line.description"/>&#8207;</td>
                                            <td t-if="o.service_category == 'periodic'">
                                                <span t-if="line.responsibility == 'owner'" style="color:#c62828; font-weight:600;">المالك</span>
                                                <span t-if="line.responsibility == 'company'" style="color:#2e7d32; font-weight:600;">الشركة</span>
                                            </td>
                                            <td style="text-align:left;"><span t-out="line.amount"/> ج.م</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div style="text-align:right;">
                                    <div class="srv-total">
                                        <span class="tl">الإجمالي</span>
                                        <span class="tv"><span t-out="o.amount"/> ج.م</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Notes -->
                            <div class="srv-section" t-if="o.notes">
                                <div class="srv-title">ملاحظات</div>
                                <div class="srv-notes"><span t-out="o.notes"/></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer حقيقي (هنا أرقام الصفحات بتشتغل) -->
                <div class="footer" style="text-align:center; font-size:10px; color:#95a5a6; direction:ltr;">
                    <span class="page"/> / <span class="topage"/>
                </div>

            </t>
        </t>
    </template>
</odoo>