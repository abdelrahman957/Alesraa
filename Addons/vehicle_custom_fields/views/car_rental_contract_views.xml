<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="car_rental_contract_form_view_inherit" model="ir.ui.view">
        <field name="name">car.rental.contract.form.inherit</field>
        <field name="model">car.rental.contract</field>
        <field name="inherit_id" ref="fleet_rental.car_rental_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='customer_id']" position="before">
                <field name="contract_type" readonly="1"/>
                <field name="sale_order_id" readonly="state not in ('draft', 'reserved')" domain="['&amp;', ('state', '=', 'sale'), '|', ('has_rental_contract', '=', False), ('id', '=', sale_order_id)]"/>
            </xpath>            
            <xpath expr="//field[@name='customer_id']" position="after">
                <field name="pickup_location" readonly="state not in ('draft', 'reserved')"/>
                <field name="dropoff_location" readonly="state not in ('draft', 'reserved', 'running')"/>
                <field name="exit_fuel" readonly="state not in ('draft', 'reserved')"/>
                <field name="exit_km" readonly="state not in ('draft', 'reserved')"/>
            </xpath> 
            <xpath expr="//field[@name='customer_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>           
            <xpath expr="//field[@name='attachment_ids']/ancestor::page[1]" position="after">
                <xpath expr="//field[@name='recurring_line']/ancestor::page[1]" position="move"/>
            </xpath>
            <xpath expr="//field[@name='attachment_ids']/ancestor::page[1]" position="after">
                <page string="Return Details" invisible="state not in ('running', 'checking', 'invoice', 'done')">                    
                    <group>
                        <field name="return_km" readonly="state not in ('draft', 'running')"/>
                        <field name="actual_return_date" readonly="state not in ('draft', 'running')"/>
                        <field name="has_damages" readonly="state not in ('draft', 'running')"/>
                        <field name="estimated_cost" invisible="has_damages != 'yes'" readonly="state not in ('draft', 'running')"/>
                        <field name="damage_description" invisible="has_damages != 'yes'" required="has_damages == 'yes'" readonly="state not in ('draft', 'running')"/>
                    </group> 
                </page>
            </xpath>            
            <xpath expr="//field[@name='attachment_ids']/ancestor::page[1]" position="attributes">
                <attribute name="string">Financial Details</attribute>
            </xpath>
            <xpath expr="//field[@name='checklist_line']//field[@name='checklist_active']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='checklist_line']//field[@name='checklist_number']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='attachment_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- إخفاء Missing Cost -->
            <xpath expr="//field[@name='tools_missing_cost']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- إخفاء Damage Cost / Balance Amount -->
            <xpath expr="//field[@name='damage_cost_sub']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- إخفاء Total الأخير -->
            <xpath expr="//field[@name='total_cost']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- إخفاء الـ total الأصلي -->
            <xpath expr="//field[@name='total']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Total بسيط زي الـ SO -->
            <xpath expr="//field[@name='total']" position="after">
                <div class="oe_right" style="text-align:right;font-size:18px;">
                    <span>Total: </span>
                    <field name="total" nolabel="1" readonly="1" class="oe_inline" style="font-weight:bold;"/>
                </div>
            </xpath>

            <!-- شيل الخط الفاصل من الـ group -->
            <xpath expr="//field[@name='total_cost']/ancestor::group[1]" position="attributes">
                <attribute name="class">oe_right</attribute>
            </xpath>
            <xpath expr="//field[@name='image']" position="replace">
                <field name="vehicle_image_display" widget="image" class="oe_avatar"/>
            </xpath>
            <xpath expr="//button[@name='force_checking']" position="attributes">
                <attribute name="name">action_open_return_wizard</attribute>
                <attribute name="type">object</attribute>
            </xpath>
        </field>
    </record>

<!-- Corporate Contracts -->
    <record id="action_corporate_contracts" model="ir.actions.act_window">
        <field name="name">Corporate Contracts</field>
        <field name="res_model">car.rental.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contract_type', '=', 'corporate')]</field>
        <field name="context">{'default_contract_type': 'corporate'}</field>
    </record>

    <!-- Retail Contracts -->
    <record id="action_retail_contracts" model="ir.actions.act_window">
        <field name="name">Retail Contracts</field>
        <field name="res_model">car.rental.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contract_type', '=', 'retail')]</field>
        <field name="context">{'default_contract_type': 'retail'}</field>
    </record>

    <!-- Menu items تحت Rental Management -->
    <menuitem id="menu_corporate_contracts"
              name="Corporate Contracts"
              parent="fleet_rental.menu_car_parent"
              action="action_corporate_contracts"
              sequence="1"/>

    <menuitem id="menu_retail_contracts"
              name="Retail Contracts"
              parent="fleet_rental.menu_car_parent"
              action="action_retail_contracts"
              sequence="2"/>

    <!-- Search view with Group By -->
    <record id="car_rental_contract_view_search" model="ir.ui.view">
        <field name="name">car.rental.contract.view.search</field>
        <field name="model">car.rental.contract</field>
        <field name="arch" type="xml">
            <search string="Rental Contracts">
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <filter string="Vehicle" name="group_vehicle"
                        context="{'group_by': 'vehicle_id'}"/>
                <filter string="Customer" name="group_customer"
                        context="{'group_by': 'customer_id'}"/>
            </search>
        </field>
    </record>

    <!-- Attach search view to the action -->
    <record id="fleet_rental.action_car_rental_contract" model="ir.actions.act_window">
        <field name="search_view_id" ref="car_rental_contract_view_search"/>
    </record>

    <!-- Rename Accessories/Tools action -->
    <record id="fleet_rental.action_fleet_car_tools" model="ir.actions.act_window">
        <field name="name">Financial Details</field>
    </record>

    <!-- Rename Accessories/Tools menu -->
    <record id="fleet_rental.menu_car_tools" model="ir.ui.menu">
        <field name="name">Financial Details</field>
    </record>


    <!-- إخفاء منيو Rental Contract الأصلية (قابل للرجوع) -->
    <record id="fleet_rental.menu_car_rental_contract" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>