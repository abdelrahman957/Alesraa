<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="car_rental_contract_form_view_inherit" model="ir.ui.view">
        <field name="name">car.rental.contract.form.inherit</field>
        <field name="model">car.rental.contract</field>
        <field name="inherit_id" ref="fleet_rental.car_rental_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='customer_id']" position="before">
                <field name="sale_order_id"/>
            </xpath>
            <xpath expr="//field[@name='customer_id']" position="after">
                <field name="pickup_location"/>
                <field name="dropoff_location"/>
                <field name="exit_fuel"/>
            </xpath>
        </field>
    </record>
</odoo>