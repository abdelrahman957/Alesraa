<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']/parent::div" position="after">
                <field name="interested_vehicle_ids" string="Car" widget="many2many_tags"
                    options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
     <record id="crm_lead_kanban_inherit" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="interested_vehicle_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>
    <record id="crm_lead_search_inherit" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="interested_vehicle_ids"/>
            </field>
            <filter name="salesperson" position="after">
                <filter string="Car" name="group_interested_vehicle"
                        context="{'group_by': 'interested_vehicle_ids'}"/>
            </filter>
        </field>
    </record>
</odoo>