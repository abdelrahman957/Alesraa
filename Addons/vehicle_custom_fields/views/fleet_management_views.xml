<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reservation Wizard Form -->
    <record id="vehicle_reservation_view_form" model="ir.ui.view">
        <field name="name">vehicle.reservation.view.form</field>
        <field name="model">vehicle.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <sheet>
                    <group>
                        <field name="vehicle_id" readonly="1"/>
                        <field name="sale_order_id"/>
                        <field name="customer_id" readonly="1"/>
                    </group>
                    <group string="Rental Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" special="save" class="btn-primary"/>
                    <button name="unlink" string="Delete Reservation" type="object"
                            class="btn-danger" invisible="not id"
                            confirm="Are you sure you want to delete this reservation?"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Fleet Management List View -->
    <record id="fleet_management_view_list" model="ir.ui.view">
            <field name="name">fleet.management.view.list</field>
            <field name="model">fleet.vehicle</field>
            <field name="mode">primary</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
            <list string="Fleet Management" create="false">
                <field name="display_name" string="Vehicle"/>
                <field name="rental_status" string="Status"
                       decoration-success="rental_status == 'Available'"
                       decoration-bf="rental_status == 'In Rent'"/>
                <field name="rental_start_date" string="Delivery Date"/>
                <field name="rental_return_date" string="Return Date"/>
                <field name="has_reservation" column_invisible="1"/>
                <field name="rental_status" column_invisible="1"/>
                <field name="reservation_source" string="Source"/>
                <field name="reservation_customer_id" string="Customer"/>
                <field name="reservation_date_from" string="Reserved From"/>
                <field name="reservation_date_to" string="Reserved Till"/>
                <field name="has_reservation" column_invisible="1"/>
                <field name="rental_status" column_invisible="1"/>
                <button name="action_make_reserve" type="object" string="Make Reserve"
                        class="btn-primary"
                        invisible="rental_status != 'In Rent' or has_reservation"/>
                <button name="action_edit_reserve" type="object" string="Edit Reserve"
                        class="btn-secondary"
                        invisible="not has_reservation"/>
                <button name="action_convert_reservation" type="object" string="Convert to Contract"
                class="btn-success"
                invisible="rental_status != 'Available' or not has_reservation"/>
            </list>
        </field>
    </record>

    <record id="fleet_management_view_search" model="ir.ui.view">
        <field name="name">fleet.management.view.search</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <search string="Fleet Management">
                <field name="rental_return_date"/>
                <filter string="In Rent" name="in_rent" domain="[('rental_status', '=', 'In Rent')]"/>
                <filter string="Available" name="available" domain="[('rental_status', '=', 'Available')]"/>
                <separator/>
                <filter string="Has Return Date" name="has_return" domain="[('rental_return_date', '!=', False)]"/>
                <filter string="Has Delivery Date" name="has_delivery" domain="[('rental_start_date', '!=', False)]"/>
                <filter string="Group by Return Date" name="group_return_date" context="{'group_by': 'rental_return_date'}"/>
                <filter string="Group by Delivery Date" name="group_delivery_date" context="{'group_by': 'rental_start_date'}"/>
                <filter string="Group by Status" name="group_status" context="{'group_by': 'rental_status'}"/>
            </search>
        </field>
    </record>

    <!-- Fleet Management Action -->
    

    <record id="action_fleet_management" model="ir.actions.act_window">
        <field name="name">Fleet Management</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="fleet_management_view_list"/>
        <field name="search_view_id" ref="fleet_management_view_search"/>
    </record>

    <!-- Rebind the Checklist menu to Fleet Management -->
    <record id="fleet_rental.menu_car_checklist" model="ir.ui.menu">
        <field name="name">Fleet Management</field>
        <field name="action" ref="action_fleet_management"/>
    </record>
    <!-- Move Services menu under Rental Management and rename to Service Report -->
    <record id="fleet.fleet_vehicle_log_services_menu" model="ir.ui.menu">
        <field name="name">Service Reports</field>
        <field name="parent_id" ref="fleet_rental.menu_car_parent"/>
    </record>
</odoo>