<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_odometer_tracking_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.tracking.list</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="arch" type="xml">
            <list string="Vehicle Odometer" create="false" edit="false">
                <field name="vehicle_id" string="License Plate"/>
                <field name="tracking_type" string="Type"/>
                <field name="responsible_id" string="Responsible"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="value" string="Odometer"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="fleet_odometer_tracking_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.tracking.search</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="arch" type="xml">
            <search string="Vehicle Odometer">
                <field name="vehicle_id"/>
                <filter string="Rent Contract" name="f_rent" domain="[('tracking_type', '=', 'rent')]"/>
                <field name="responsible_id"/>
                <filter string="Service" name="f_service" domain="[('tracking_type', '=', 'service')]"/>
                <separator/>
                <filter string="Vehicle" name="g_vehicle" context="{'group_by': 'vehicle_id'}"/>
                <filter string="Type" name="g_type" context="{'group_by': 'tracking_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_fleet_odometer_tracking" model="ir.actions.server">
        <field name="name">Vehicle Odometer</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle_odometer"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_tracking()</field>
    </record>

    <menuitem id="menu_fleet_odometer_tracking"
              name="Vehicle Odometer"
              parent="fleet.fleet_vehicles"
              action="action_fleet_odometer_tracking"
              sequence="53"/>

</odoo>