<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_service_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.form.inherit</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ('done', 'cancelled')"/>
            </xpath>

            <!-- أزرار الـ Workflow في الـ header -->
            <xpath expr="//header" position="inside">
                <button name="action_service_run" string="Run" type="object"
                        class="btn-primary" invisible="state != 'new'"/>
                <button name="action_service_done" string="Done" type="object"
                        class="btn-primary" invisible="state != 'running'"/>
                <button name="action_service_cancel" string="Cancel" type="object"
                        invisible="state != 'done'"/>
            </xpath>

            <!-- الـ statusbar: مش clickable + إظهار الحالات -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">new,running,done</attribute>
                <attribute name="options">{'clickable': False}</attribute>
            </xpath>

            <!-- قفل الحقول العلوية في done/cancelled -->
            <xpath expr="//field[@name='vehicle_id']" position="attributes">
                <attribute name="readonly">state in ('done','cancelled')</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="readonly">state in ('done','cancelled')</attribute>
            </xpath>
            <xpath expr="//field[@name='vendor_id']" position="attributes">
                <attribute name="readonly">state in ('done','cancelled')</attribute>
            </xpath>
            <xpath expr="//field[@name='purchaser_id']" position="attributes">
                <attribute name="readonly">state in ('done','cancelled')</attribute>
                <attribute name="domain">[('is_driver', '=', True)]</attribute>
            </xpath>            
            <xpath expr="//field[@name='odometer']" position="attributes">
                <attribute name="readonly">state in ('done','cancelled')</attribute>
            </xpath>
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="readonly">state in ('done','cancelled')</attribute>
            </xpath>
            <xpath expr="//field[@name='notes']" position="attributes">
                <attribute name="readonly">state in ('done','cancelled')</attribute>
            </xpath>

            <!-- Service Type مخفي -->
            <xpath expr="//field[@name='service_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Amount الأصلي readonly -->
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>


            <!-- بنود الصيانة قبل الـ Notes -->
            <xpath expr="//field[@name='notes']/preceding-sibling::separator[1]" position="before">
                <separator string="Service Details"/>
                <field name="service_line_ids" widget="section_and_note_one2many">
                    <list editable="bottom">
                        <field name="service_type_id"
                               readonly="parent.state in ('done','cancelled')"/>
                        <field name="responsibility"
                               groups="fleet.fleet_group_manager"
                               readonly="parent.state == 'cancelled'"/>
                        <field name="description"
                               readonly="parent.state == 'cancelled'"/>
                        <field name="deduction_date"
                               readonly="parent.state in ('done','cancelled')"/>
                        <field name="amount" widget="monetary"
                               readonly="parent.state in ('done','cancelled')"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer oe_right">
                    <field name="amount" widget="monetary" string="Total"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- List view: شيل صورة العربية -->
    <record id="fleet_service_list_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.list.inherit</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vehicle_id']" position="attributes">
                <attribute name="widget"></attribute>
            </xpath>
            <xpath expr="//field[@name='service_type_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- شاشة مدير الحركة: تقارير فيها Responsibility ناقصة -->
    <record id="fleet_service_pending_search" model="ir.ui.view">
        <field name="name">fleet.service.pending.search</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Pending Responsibility">
                <field name="vehicle_id"/>
                <filter string="Pending Responsibility" name="pending"
                        domain="[('has_pending_responsibility', '=', True)]"/>
                <separator/>
                <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_fleet_service_pending" model="ir.actions.act_window">
        <field name="name">Pending Responsibility</field>
        <field name="res_model">fleet.vehicle.log.services</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fleet_service_pending_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="domain">[('has_pending_responsibility', '=', True)]</field>
    </record>

    <menuitem id="menu_fleet_service_pending"
              name="Pending Responsibility"
              parent="fleet.fleet_vehicles"
              action="action_fleet_service_pending"
              groups="fleet.fleet_group_manager"
              sequence="55"/>
    
    <record id="fleet_service_search_extra" model="ir.ui.view">
        <field name="name">fleet.service.search.extra</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="purchaser_id" string="Driver"/>
                <field name="vendor_id" string="Vendor"/>
                <field name="amount"/>
            </xpath>
        </field>
    </record>

</odoo>