<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_service_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.form.inherit</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_form"/>
        <field name="arch" type="xml">
            <!-- إخفاء Service Type من مكانه الأصلي (هننقله للـ lines) -->
            <xpath expr="//field[@name='service_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- إخفاء Amount الأصلي (بقى computed من الـ lines) -->
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <!-- إضافة Service Category و Customer Charge بعد Description -->
            <xpath expr="//field[@name='description']" position="after">
                <field name="service_category"/>
                <field name="customer_charge" widget="monetary"
                       invisible="service_category != 'accident'"/>
            </xpath>
            <!-- إضافة الـ Lines قبل الـ Notes -->
            <xpath expr="//field[@name='notes']" position="before">
                <separator string="Service Details"/>
                <field name="service_line_ids">
                    <list editable="bottom">
                        <field name="service_category" column_invisible="1"/>
                        <field name="service_type_id"/>
                        <field name="responsibility"
                               column_invisible="parent.service_category != 'periodic'"/>
                        <field name="description"/>
                        <field name="amount" widget="monetary"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer oe_right">
                    <field name="amount" widget="monetary"
                           string="Total"
                           class="oe_subtotal_footer_separator"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- List view: شيل صورة العربية (avatar) -->
    <record id="fleet_service_list_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.list.inherit</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vehicle_id']" position="attributes">
                <attribute name="widget"></attribute>
            </xpath>
        </field>
    </record>

</odoo>