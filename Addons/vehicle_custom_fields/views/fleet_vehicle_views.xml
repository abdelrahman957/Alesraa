<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_vehicle_form_view_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="has_gps"/>
                <field name="gps_installation_date" invisible="not has_gps"/>
                <field name="driving_license_expiry"/>
                <field name="motor_number"/>
                <field name="insurance_type_id"/>
                <field name="insurance_end_date"/>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='write_off_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='manager_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='page_tax_info']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_list_view_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list string="Vehicle" multi_edit="1" sample="1">
                    <field name="active" column_invisible="True"/>
                    <field name="model_id" string="Model" widget="many2one_avatar" readonly="1"/>
                    <field name="model_year" optional="show"/>
                    <field name="license_plate" readonly="1"/>
                    <field name="vin_sn" string="Chassis Number" readonly="1" optional="show"/>
                    <field name="motor_number" optional="show"/>
                    <field name="owner_id" string="Owner" optional="show"/>
                    <field name="owner_mobile" string="Mobile" optional="show"/>
                    <field name="owner_vat" string="ID" optional="show"/>
                    <field name="driver_id" widget="many2one_avatar" readonly="1" optional="show"/>
                    <field name="has_gps" string="GPS" optional="show"/>
                    <field name="driving_license_expiry" string="Driving License Expiry" optional="show"/>
                    <field name="insurance_type_id" optional="show"/>
                    <field name="insurance_end_date" optional="show"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="1" optional="show"/>
                </list>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_insurance_type_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.insurance.type.form</field>
        <field name="model">fleet.vehicle.insurance.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fleet_vehicle_insurance_type_view_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.insurance.type.tree</field>
        <field name="model">fleet.vehicle.insurance.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_fleet_vehicle_insurance_type" model="ir.actions.act_window">
        <field name="name">Insurance Types</field>
        <field name="res_model">fleet.vehicle.insurance.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fleet_insurance_type"
        name="Insurance Types"
        parent="fleet.fleet_configuration"
        action="action_fleet_vehicle_insurance_type"
        sequence="20"/>

</odoo>