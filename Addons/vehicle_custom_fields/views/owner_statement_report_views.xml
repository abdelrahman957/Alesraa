<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="owner_statement_report_form" model="ir.ui.view">
        <field name="name">owner.statement.report.form</field>
        <field name="model">owner.statement.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_compute" string="Compute" type="object"
                            class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_view_bill" string="View Bill" type="object"
                            class="btn-secondary" invisible="not bill_id"/>
                    <button name="action_set_draft" string="Set to Draft" type="object"
                            invisible="state != 'confirmed' or is_paid"/>
                    <field name="is_paid" invisible="1"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not pending_warning"
                         style="white-space: pre-line;">
                        <field name="pending_warning" readonly="1" nolabel="1"/>
                    </div>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success"
                            invisible="not is_paid"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id" readonly="state != 'draft'"/>
                            <field name="owner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="total_amount"/>
                            <field name="bill_id" readonly="1" invisible="not bill_id"/>
                            <field name="payment_state" invisible="not bill_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="line_type"/>
                                    <field name="date"/>
                                    <field name="description"/>
                                    <field name="is_manual" readonly="1" optional="hide"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="owner_statement_report_list" model="ir.ui.view">
        <field name="name">owner.statement.report.list</field>
        <field name="model">owner.statement.report</field>
        <field name="arch" type="xml">
            <list string="Owner Statement Reports">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="owner_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
                <field name="payment_state" widget="badge"
                       decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state == 'not_paid'"
                       optional="show"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_owner_statement_report" model="ir.actions.act_window">
        <field name="name">Owner Statement Reports</field>
        <field name="res_model">owner.statement.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_owner_statement_report"
              name="Owner Statement Reports"
              parent="fleet.fleet_vehicles"
              action="action_owner_statement_report"
              sequence="51"/>

</odoo>