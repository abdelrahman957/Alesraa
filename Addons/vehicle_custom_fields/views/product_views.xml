<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.vehicle</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <div class="alert alert-info" role="alert" colspan="2" style="margin:8px 0; font-size:13px;">
                    <span>💡 If this product is a vehicle, please check "Is Vehicle" below.</span><br/>
                    <span dir="rtl">💡 لو المنتج ده عربية، من فضلك علّم على خانة "Is Vehicle" بالأسفل.</span>
                </div>
                <field name="is_vehicle" string="Is Vehicle"/>
                <field name="fleet_model_id" string="Vehicle Model"
                       invisible="not is_vehicle"
                       required="is_vehicle"/>
            </xpath>
        </field>
    </record>
</odoo>