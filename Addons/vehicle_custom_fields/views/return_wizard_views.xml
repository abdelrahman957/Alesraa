<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="car_rental_return_wizard_form" model="ir.ui.view">
        <field name="name">car.rental.return.wizard.form</field>
        <field name="model">car.rental.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Vehicle Return">
                <group>
                    <field name="contract_id" invisible="1"/>
                    <field name="from_fleet" invisible="1"/>
                    <group string="Return Details">
                        <field name="actual_return_date" invisible="from_fleet == True"/>
                        <field name="extra_days" readonly="1" invisible="extra_days == 0"/>
                        <field name="day_rate" invisible="extra_days == 0"/>
                        <field name="return_km" invisible="from_fleet == True"/>
                        <field name="consumed_km" readonly="1"/>
                        <field name="km_per_day"/>
                        <field name="extra_km" readonly="1"/>
                        <field name="extra_km_price"/>
                        <field name="total_ex_km_amount" readonly="1"/>
                        <field name="has_damages"/>
                        <field name="estimated_cost" invisible="has_damages != 'yes'"/>
                        <field name="damage_description" invisible="has_damages != 'yes'" required="has_damages == 'yes'"/>
                    </group>
                    <group string="Insurance Calculation">
                        <field name="insurance_amount" readonly="1"/>
                        <field name="ex_km_deduction" readonly="1"/>
                        <field name="estimated_cost_deduction" readonly="1"/>
                        <field name="extra_days_amount" readonly="1"/>
                        <field name="net_insurance" readonly="1"/>
                    </group>
                    <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>