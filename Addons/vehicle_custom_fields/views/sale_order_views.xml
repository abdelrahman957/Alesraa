<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rental</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <separator string="Rental Period"/>
                <div class="row">
                    <div class="col-12">
                        <label for="rental_date_from" string="From"/>
                        <field name="rental_date_from" nolabel="1" class="w-100"/>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <label for="rental_date_to" string="To"/>
                        <field name="rental_date_to" nolabel="1" class="w-100"/>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <label for="rental_duration" string="Duration"/>
                        <field name="rental_duration" nolabel="1" readonly="1" class="w-100"/>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <label for="delivery_location" string="Delivery Location"/>
                        <field name="delivery_location" nolabel="1" class="w-100"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>