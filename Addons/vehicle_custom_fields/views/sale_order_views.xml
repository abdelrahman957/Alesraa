<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rental</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <separator string="Rental Period"/>
                <group>
                    <group string="Dates">
                        <field name="rental_date_from" string="From"/>
                        <field name="rental_date_to" string="To"/>
                        <field name="rental_duration" string="Duration" readonly="1"/>
                    </group>
                    <group string="Delivery">
                        <field name="delivery_location" string="Delivery Location"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>