<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.rental</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']/.." position="after">
                <separator string="Rental Period"/>
                <group>
                    <group colspan="4">
                        <field name="rental_date_from" string="From"/>
                    </group>
                    <group colspan="4">
                        <field name="rental_date_to" string="To"/>
                    </group>
                    <group colspan="4">
                        <field name="rental_duration" string="Duration" readonly="1"/>
                    </group>
                    <group colspan="4">
                        <field name="delivery_location" string="Delivery Location"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rental_contracts"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-car">
                    <field name="rental_contract_count" widget="statinfo" string="Rental Contracts"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="sale_order_list_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.rental</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="has_rental_contract" string="Rental Contract" optional="show" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_search_view_inherit" model="ir.ui.view">
    <field name="name">sale.order.search.inherit.rental</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
    <field name="arch" type="xml">
        <xpath expr="//search" position="inside">
            <separator/>
            <filter string="Has Rental Contract"
                    name="has_rental_contract"
                    domain="[('has_rental_contract', '=', True)]"/>
            <filter string="No Rental Contract"
                    name="no_rental_contract"
                    domain="[('has_rental_contract', '=', False)]"/>
            <group expand="0" string="Group By">
                <filter string="Rental Contract"
                        name="group_has_rental_contract"
                        context="{'group_by': 'has_rental_contract'}"/>
            </group>
        </xpath>
    </field>
</record>

</odoo>