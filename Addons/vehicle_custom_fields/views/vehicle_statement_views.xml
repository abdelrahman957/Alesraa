<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vehicle_statement_list" model="ir.ui.view">
        <field name="name">vehicle.statement.line.list</field>
        <field name="model">vehicle.statement.line</field>
        <field name="arch" type="xml">
            <list string="Vehicle Statement" create="false" edit="false">
                <field name="line_type" string="Type"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="owner_id"/>
                <field name="description"/>
                <button name="action_open_source" type="object" class="btn-link" string="Open"/>
                <field name="source_label" string="Source"/>
                <field name="amount" sum="Net"/>
            </list>
        </field>
    </record>

    <record id="vehicle_statement_search" model="ir.ui.view">
        <field name="name">vehicle.statement.line.search</field>
        <field name="model">vehicle.statement.line</field>
        <field name="arch" type="xml">
            <search string="Vehicle Statement">
                <field name="vehicle_id"/>
                <field name="owner_id"/>
                <filter string="Revenue" name="f_rent" domain="[('line_type', '=', 'rent')]"/>
                <filter string="Rent Cost" name="f_rent_cost" domain="[('line_type', '=', 'rent_cost')]"/>
                <filter string="Service Cost" name="f_service" domain="[('line_type', '=', 'service')]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Vehicle" name="g_vehicle" context="{'group_by': 'vehicle_id'}"/>
                <filter string="Owner" name="g_owner" context="{'group_by': 'owner_id'}"/>
                <filter string="Type" name="g_type" context="{'group_by': 'line_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_vehicle_statement" model="ir.actions.act_window">
        <field name="name">Vehicle Statement</field>
        <field name="res_model">vehicle.statement.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="vehicle_statement_list"/>
        <field name="search_view_id" ref="vehicle_statement_search"/>
        <field name="context">{'search_default_g_vehicle': 1}</field>
    </record>

    <record id="action_refresh_vehicle_statement" model="ir.actions.server">
        <field name="name">Refresh Data</field>
        <field name="model_id" ref="model_vehicle_statement_line"/>
        <field name="binding_model_id" ref="model_vehicle_statement_line"/>
        <field name="state">code</field>
        <field name="code">action = model.action_refresh()</field>
    </record>

    <menuitem id="menu_vehicle_statement"
              name="Vehicle Statement"
              parent="fleet.fleet_vehicles"
              action="action_vehicle_statement"
              sequence="52"/>

</odoo>